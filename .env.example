# Copy this file to .env and set a local password:
#   cp .env.example .env
#
# These values are consumed by docker-compose (variable substitution) and, in
# turn, injected into the API and seeder containers. The real .env is
# git-ignored and must never be committed.

# Bolt URI.
#   - Inside docker-compose, the Neo4j host is the service name "neo4j".
#   - To run the app/seed script directly on your host instead, use:
#       bolt://localhost:7687
NEO4J_URI=bolt://neo4j:7687

# Neo4j's default username is "neo4j".
NEO4J_USER=neo4j

# Any local dev password (minimum 8 characters). Do NOT reuse a real secret.
NEO4J_PASSWORD=change-me-local-dev
